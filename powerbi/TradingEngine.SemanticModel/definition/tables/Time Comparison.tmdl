/// Calculation group: switches any measure between Current / MTD / QTD / YTD from one slicer,
/// without writing a time-intelligence variant of every measure. Not currently bound to a visual -
/// drop [View] on a page as a slicer to activate it across the whole report.
table 'Time Comparison'
	lineageTag: c1a1c1a1-0000-4000-8000-000000000010

	calculationGroup
		precedence: 10

		calculationItem Current = SELECTEDMEASURE ( )

		calculationItem MTD = CALCULATE ( SELECTEDMEASURE ( ), DATESMTD ( DimDate[Date] ) )

		calculationItem QTD = CALCULATE ( SELECTEDMEASURE ( ), DATESQTD ( DimDate[Date] ) )

		calculationItem YTD = CALCULATE ( SELECTEDMEASURE ( ), DATESYTD ( DimDate[Date] ) )

	/// Slicer column: Current / MTD / QTD / YTD. Sorted by Ordinal, not alphabetically.
	column View
		dataType: string
		lineageTag: c1a1c1a1-0000-4000-8000-000000000011
		summarizeBy: none
		sourceColumn: Name
		sortByColumn: Ordinal

		annotation SummarizationSetBy = Automatic

	column Ordinal
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: c1a1c1a1-0000-4000-8000-000000000012
		summarizeBy: sum
		sourceColumn: Ordinal

		annotation SummarizationSetBy = Automatic

