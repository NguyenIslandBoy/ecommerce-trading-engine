/// Channel lookup (4 rows). Presentational only - display names, sort order, and
/// whether cost data exists for the channel. The channel domain itself is defined and
/// tested in dbt; this table does not redefine it.
table DimChannel
	lineageTag: 3b89ae35-871f-42c3-8f1e-0e6ecc6fa4c8

	/// Join key. Matches FactDailyTrading[channel] and CohortLTV[acquisition_channel].
	column channel
		dataType: string
		isKey
		lineageTag: 29088fc9-426d-4127-b74f-a06a81fe0530
		summarizeBy: none
		sourceColumn: channel

		annotation SummarizationSetBy = Automatic

	/// Display name.
	column channel_name
		dataType: string
		lineageTag: aa3f0eb4-b52b-44d8-83ef-3fbd1f584325
		summarizeBy: none
		sourceColumn: channel_name

		annotation SummarizationSetBy = Automatic

	/// Sort order for visuals (Google, Meta, Unattributed, TikTok).
	column sort_order
		dataType: int64
		formatString: 0
		lineageTag: 9cbfa808-0806-4f6e-a1b5-c964dab4c016
		summarizeBy: none
		sourceColumn: sort_order

		annotation SummarizationSetBy = Automatic

	/// FALSE for TikTok (9% of orders, no cost file) and Unattributed. Where this is
	/// FALSE, CAC is not computable and must render blank - never zero, which would
	/// claim free acquisition.
	column has_cost_data
		dataType: boolean
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: e1738886-b433-4414-b83a-cc7ba7e391d0
		summarizeBy: none
		sourceColumn: has_cost_data

		annotation SummarizationSetBy = Automatic

	partition DimChannel = m
		mode: import
		source =
				let
				    Source = #table(
				        type table [channel = text, channel_name = text, sort_order = Int64.Type, has_cost_data = logical],
				        {
				            {"google",       "Google",       1, true},
				            {"meta",         "Meta",         2, true},
				            {"unattributed", "Unattributed", 3, false},
				            {"tiktok",       "TikTok",       4, false}
				        })
				in
				    Source

	annotation PBI_ResultType = Table
