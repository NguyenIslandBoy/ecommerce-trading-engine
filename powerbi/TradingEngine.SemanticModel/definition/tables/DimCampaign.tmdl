/// Ad campaigns across both platforms (11 rows: 6 Meta, 5 Google). Funnel stage is parsed from the campaign name.
table DimCampaign
	lineageTag: 5bbe8004-88aa-48a3-9d5d-31393316b586

	/// platform:campaign_id. Primary key.
	column campaign_key
		dataType: string
		isKey
		lineageTag: 1e5b2d5a-cf7d-42fd-bea5-eff3903b45ba
		summarizeBy: none
		sourceColumn: campaign_key

	column platform
		dataType: string
		lineageTag: 4247a171-7d07-495f-b802-6b2753514ed4
		summarizeBy: none
		sourceColumn: platform

	column campaign_id
		dataType: string
		lineageTag: dc7f265c-c158-430b-8ef4-4a8105a73ef7
		summarizeBy: none
		sourceColumn: campaign_id

	column campaign_name
		dataType: string
		lineageTag: 11f2f2d4-23ae-4fa7-947e-e17cc3b3b83d
		summarizeBy: none
		sourceColumn: campaign_name

	/// Prospecting / Retargeting / Catalogue / Brand / Non-brand / Shopping / PMax.
	column funnel_stage
		dataType: string
		lineageTag: 56c45c53-6932-498c-8c2d-625a04c7b3e4
		summarizeBy: none
		sourceColumn: funnel_stage

	partition DimCampaign = m
		mode: import
		source =
				let
				    Source = Parquet.Document(File.Contents(DataFolder & "\dim_campaign.parquet"))
				in
				    Source

