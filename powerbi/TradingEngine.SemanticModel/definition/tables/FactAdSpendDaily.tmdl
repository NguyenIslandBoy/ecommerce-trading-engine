/// Ad spend at campaign-day grain (4,003 rows). Meta 2,178 across 363 days — the 2 missing days are a real ingestion gap, not zero spend.
table FactAdSpendDaily
	lineageTag: e90eaa0d-f05a-47af-b25a-ed0938e71f24

	column campaign_key
		dataType: string
		lineageTag: d77d7e95-1f56-4fd0-b773-3ae740a6d97a
		summarizeBy: none
		sourceColumn: campaign_key

		annotation SummarizationSetBy = Automatic

	column platform
		dataType: string
		lineageTag: c0929e96-92a0-4e2b-928a-bd7b260259f7
		summarizeBy: none
		sourceColumn: platform

		annotation SummarizationSetBy = Automatic

	column campaign_id
		dataType: string
		lineageTag: 51571c63-2668-425a-9323-c827f8075b53
		summarizeBy: none
		sourceColumn: campaign_id

		annotation SummarizationSetBy = Automatic

	column funnel_stage
		dataType: string
		lineageTag: ecb82b46-82da-4c17-b5be-f8934e0007a7
		summarizeBy: none
		sourceColumn: funnel_stage

		annotation SummarizationSetBy = Automatic

	column ad_date
		dataType: dateTime
		formatString: dd/MM/yyyy
		lineageTag: b64428d2-8f4d-40f6-88a4-341add73c5ce
		summarizeBy: none
		sourceColumn: ad_date

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column impressions
		dataType: double
		formatString: #,0.00
		lineageTag: 345e06d2-129b-4598-8ef5-54d54c442d72
		summarizeBy: sum
		sourceColumn: impressions

		annotation SummarizationSetBy = Automatic

	column clicks
		dataType: double
		formatString: #,0.00
		lineageTag: 2738d6a4-38bd-4c71-8e20-49a13da859a6
		summarizeBy: sum
		sourceColumn: clicks

		annotation SummarizationSetBy = Automatic

	column spend
		dataType: decimal
		formatString: \£#,0.00;-\£#,0.00;\£#,0.00
		lineageTag: 66a5747b-0015-4e31-8b31-bd93fd1d716f
		summarizeBy: sum
		sourceColumn: spend

		annotation SummarizationSetBy = Automatic

	column reach
		dataType: double
		formatString: #,0.00
		lineageTag: 557c1586-d2c2-43b3-b196-ea1f5e565a94
		summarizeBy: sum
		sourceColumn: reach

		annotation SummarizationSetBy = Automatic

	column frequency
		dataType: double
		formatString: #,0.00
		lineageTag: 5b917de6-cc0f-489d-8e2f-a1e6a138f177
		summarizeBy: sum
		sourceColumn: frequency

		annotation SummarizationSetBy = Automatic

	/// NULL for Meta, which reports no conversions at all. Zero would mean "measured, and it was none" — a different and wrong claim.
	column platform_conversions
		dataType: double
		formatString: #,0.00
		lineageTag: 23b77d88-4d23-4542-b971-3712cf70a62b
		summarizeBy: sum
		sourceColumn: platform_conversions

		annotation SummarizationSetBy = Automatic

	column platform_conversion_value
		dataType: decimal
		formatString: \£#,0.00;-\£#,0.00;\£#,0.00
		lineageTag: 1fccba36-1896-459c-ab71-49aacac2b044
		summarizeBy: sum
		sourceColumn: platform_conversion_value

		annotation SummarizationSetBy = Automatic

	/// Cost per click. CPC = CPM / (1000 x CTR) is an arithmetic identity, tested in the warehouse.
	column cpc
		dataType: decimal
		formatString: \£#,0.00;-\£#,0.00;\£#,0.00
		lineageTag: f0bca26e-66f0-4f66-acd4-4065a5abc522
		summarizeBy: sum
		sourceColumn: cpc

		annotation SummarizationSetBy = Automatic

	/// Cost per thousand impressions — the AUCTION component of a CPC move. Not controllable.
	column cpm
		dataType: decimal
		formatString: \£#,0.00;-\£#,0.00;\£#,0.00
		lineageTag: 9fffec79-1e05-4029-833c-02c00f75ed1e
		summarizeBy: sum
		sourceColumn: cpm

		annotation SummarizationSetBy = Automatic

	/// Click-through rate — the CREATIVE component of a CPC move. Controllable.
	column ctr
		dataType: decimal
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: bf6634dd-57c8-435c-9d91-b36d2d24cb45
		summarizeBy: none
		sourceColumn: ctr

		annotation SummarizationSetBy = Automatic

	partition FactAdSpendDaily = m
		mode: import
		source =
				let
				    Source = Parquet.Document(File.Contents(DataFolder & "\fct_ad_spend_daily.parquet"))
				in
				    Source

	annotation PBI_ResultType = Table
