/// PRIMARY FACT. Daily trading by last-click channel (365 days x 4 channels = 1,460 rows). The metric spine.
table FactDailyTrading
	lineageTag: e3f94b1a-97ea-439d-ab8e-1f1b3a1f2320

	column date_day
		dataType: dateTime
		formatString: dd/MM/yyyy
		lineageTag: fee1728c-0117-483d-9ed4-aead1d3b3130
		summarizeBy: none
		sourceColumn: date_day

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column channel
		dataType: string
		lineageTag: 78fc53ab-74dc-4db2-829c-a8a264c4cce8
		summarizeBy: none
		sourceColumn: channel

		annotation SummarizationSetBy = Automatic

	column orders
		dataType: int64
		formatString: #,0
		lineageTag: 61dd4e97-295f-4047-98ea-8effbf5d9cbc
		summarizeBy: sum
		sourceColumn: orders

		annotation SummarizationSetBy = Automatic

	column new_customers
		dataType: int64
		formatString: #,0
		lineageTag: 7b1f98fc-7531-4ff0-980c-4cdcab574221
		summarizeBy: sum
		sourceColumn: new_customers

		annotation SummarizationSetBy = Automatic

	column returning_customers
		dataType: int64
		formatString: #,0
		lineageTag: 58a022a9-d4a8-4148-b3ae-7183b9ffae9a
		summarizeBy: sum
		sourceColumn: returning_customers

		annotation SummarizationSetBy = Automatic

	/// EX-VAT net revenue. Will not match a VAT-inclusive figure quoted elsewhere.
	column net_revenue
		dataType: decimal
		formatString: \£#,0.00;-\£#,0.00;\£#,0.00
		lineageTag: f7c55fc7-017f-4997-a3e8-e3fd0f23a20f
		summarizeBy: sum
		sourceColumn: net_revenue

		annotation SummarizationSetBy = Automatic

	/// Ex-VAT revenue less COGS. All value metrics are margin-based, not revenue-based.
	column contribution_margin
		dataType: decimal
		formatString: \£#,0.00;-\£#,0.00;\£#,0.00
		lineageTag: 95772f79-6d79-440a-9aa0-34f5c2f26a7d
		summarizeBy: sum
		sourceColumn: contribution_margin

		annotation SummarizationSetBy = Automatic

	/// Ex-VAT and excludes shipping. Will not match a VAT-inclusive AOV.
	column aov
		dataType: decimal
		formatString: \£#,0.00;-\£#,0.00;\£#,0.00
		lineageTag: ae0b6be9-7863-4bf7-8d71-2562f9fe30fe
		summarizeBy: sum
		sourceColumn: aov

		annotation SummarizationSetBy = Automatic

	column ad_spend
		dataType: decimal
		formatString: \£#,0.00;-\£#,0.00;\£#,0.00
		lineageTag: d8c08464-bf58-482c-ada2-6ea3c2a79f4d
		summarizeBy: sum
		sourceColumn: ad_spend

		annotation SummarizationSetBy = Automatic

	column clicks
		dataType: double
		formatString: #,0.00
		lineageTag: 51e66b29-e694-4975-8cb2-7f7824206b41
		summarizeBy: sum
		sourceColumn: clicks

		annotation SummarizationSetBy = Automatic

	column impressions
		dataType: double
		formatString: #,0.00
		lineageTag: 197a88d0-c985-4011-a105-220a3ef9f5ba
		summarizeBy: sum
		sourceColumn: impressions

		annotation SummarizationSetBy = Automatic

	/// TIER C — depends on last-click attribution, which is unreliable here (26.9% of orders unattributed). NULL for tiktok and unattributed by construction.
	column channel_cac
		dataType: decimal
		formatString: \£#,0.00;-\£#,0.00;\£#,0.00
		lineageTag: 086b423b-405c-421f-beeb-486fd463a46e
		summarizeBy: sum
		sourceColumn: channel_cac

		annotation SummarizationSetBy = Automatic

	/// Ex-VAT, so ~17% lower than a platform-reported ROAS. Tier C.
	column channel_roas
		dataType: decimal
		formatString: #,0.00
		lineageTag: aceee3dd-8276-4804-8716-db0a5490c527
		summarizeBy: none
		sourceColumn: channel_roas

		annotation SummarizationSetBy = Automatic

	column channel_margin_roas
		dataType: decimal
		formatString: #,0.00
		lineageTag: b55a9689-6821-42a1-8821-a8514801865c
		summarizeBy: none
		sourceColumn: channel_margin_roas

		annotation SummarizationSetBy = Automatic

	/// FALSE when any ad source has an ingestion gap that day. Load-bearing: without it, blended CAC on the two missing Meta days reads a fabricated 42% improvement.
	column ad_spend_is_complete
		dataType: boolean
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 1687798f-4b78-4dcb-8a9c-da7ffe5d36d8
		summarizeBy: none
		sourceColumn: ad_spend_is_complete

		annotation SummarizationSetBy = Automatic

	/// TIER B — total spend / total new customers. Attribution-free, the trustworthy cross-check. NULL when ad_spend_is_complete is false.
	column blended_cac
		dataType: decimal
		formatString: \£#,0.00;-\£#,0.00;\£#,0.00
		lineageTag: e1516d20-30d0-447a-ab6d-72f26fb44d3f
		summarizeBy: sum
		sourceColumn: blended_cac

		annotation SummarizationSetBy = Automatic

	column is_peak_season
		dataType: boolean
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: ef1204b3-33a3-416e-adc3-50e5d257e9c0
		summarizeBy: none
		sourceColumn: is_peak_season

		annotation SummarizationSetBy = Automatic

	column iso_dow
		dataType: int64
		formatString: #,0
		lineageTag: 48f863f3-8f63-472a-99c4-4bb1d17ae299
		summarizeBy: sum
		sourceColumn: iso_dow

		annotation SummarizationSetBy = Automatic

	column week_start
		dataType: dateTime
		formatString: dd/MM/yyyy
		lineageTag: f4829b94-9361-431e-845e-dc28e67bbb5c
		summarizeBy: none
		sourceColumn: week_start

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	partition FactDailyTrading = m
		mode: import
		source =
				let
				    Source = Parquet.Document(File.Contents(DataFolder & "\mart_daily_trading.parquet"))
				in
				    Source

	annotation PBI_ResultType = Table
