/// Per-source, per-day completeness audit (1,095 rows). A first-class table, so 'is this a data gap or a real event' is a join, not an opinion.
table FactDataQuality
	lineageTag: 114f209b-afbf-4e99-9262-c752af0e563e

	column source_name
		dataType: string
		lineageTag: 0efeda89-c8cf-4cae-9b7f-43c132553972
		summarizeBy: none
		sourceColumn: source_name

	column date_day
		dataType: dateTime
		formatString: dd/MM/yyyy
		lineageTag: 8b06f593-695e-40e5-9c50-57390385a2fc
		summarizeBy: none
		sourceColumn: date_day

	column expected
		dataType: boolean
		lineageTag: 4a0586f1-7a57-4c79-a0c1-56b2570fce69
		summarizeBy: none
		sourceColumn: expected

	column observed
		dataType: boolean
		lineageTag: b9bd557d-755a-4b22-b10f-efffb9622a58
		summarizeBy: none
		sourceColumn: observed

	/// TRUE where the source has no rows that day. Currently 2: meta_ads_daily on 2025-03-15 and 2025-03-16.
	column is_gap
		dataType: boolean
		lineageTag: 46d64e07-3bba-4c92-ae3c-7be38976e6a4
		summarizeBy: none
		sourceColumn: is_gap

	column row_count
		dataType: int64
		formatString: #,0
		lineageTag: d5cf9397-78e1-4bc7-936e-6c3c6ec4b8fe
		summarizeBy: sum
		sourceColumn: row_count

	column expected_count
		dataType: int64
		formatString: #,0
		lineageTag: 68c835a7-e369-496f-98af-24055da2671f
		summarizeBy: sum
		sourceColumn: expected_count

	column issue_type
		dataType: string
		lineageTag: 5910b286-70d9-4ce7-a458-8abc326ea640
		summarizeBy: none
		sourceColumn: issue_type

	partition FactDataQuality = m
		mode: import
		source =
				let
				    Source = Parquet.Document(File.Contents(DataFolder & "\mart_data_quality.parquet"))
				in
				    Source

