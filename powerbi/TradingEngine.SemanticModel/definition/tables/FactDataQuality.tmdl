/// Per-source, per-day completeness audit (3 sources x 365 days = 1,095 rows). A first-class table, so "is this a data gap or a real event" is a join, not an opinion.
table FactDataQuality
	lineageTag: 68b7f339-3014-4bad-96a9-83e992f568b3

	column source_name
		dataType: string
		lineageTag: d6481d38-e110-43b5-8931-21df310e2e3b
		summarizeBy: none
		sourceColumn: source_name

		annotation SummarizationSetBy = Automatic

	column date_day
		dataType: dateTime
		formatString: dd/MM/yyyy
		lineageTag: ec6ec173-e818-465e-a3ff-43c567151878
		summarizeBy: none
		sourceColumn: date_day

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column expected
		dataType: boolean
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: f344f88a-6f4d-4d5f-91ec-bf1bb3070917
		summarizeBy: none
		sourceColumn: expected

		annotation SummarizationSetBy = Automatic

	column observed
		dataType: boolean
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 3f0b9e00-c3cf-4242-9178-14fdd38974cf
		summarizeBy: none
		sourceColumn: observed

		annotation SummarizationSetBy = Automatic

	/// TRUE where the source has no rows for that day. Currently 2 rows: meta_ads_daily on 2025-03-15 and 2025-03-16.
	column is_gap
		dataType: boolean
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 4f83bafe-d6ae-405d-8aac-5f6f342a49f5
		summarizeBy: none
		sourceColumn: is_gap

		annotation SummarizationSetBy = Automatic

	column row_count
		dataType: int64
		formatString: #,0
		lineageTag: 829e4548-afe0-494c-bab4-cdc87c9c48a6
		summarizeBy: sum
		sourceColumn: row_count

		annotation SummarizationSetBy = Automatic

	column expected_count
		dataType: int64
		formatString: #,0
		lineageTag: 358c192f-9714-4306-b327-5c8b4a563078
		summarizeBy: sum
		sourceColumn: expected_count

		annotation SummarizationSetBy = Automatic

	/// missing_day (no rows) or partial_day (fewer campaigns than expected) or ok.
	column issue_type
		dataType: string
		lineageTag: fcd803d5-6d8b-4f34-a1f8-8a17f6a94ae6
		summarizeBy: none
		sourceColumn: issue_type

		annotation SummarizationSetBy = Automatic

	partition FactDataQuality = m
		mode: import
		source =
				let
				    Source = Parquet.Document(File.Contents(DataFolder & "\mart_data_quality.parquet"))
				in
				    Source

	annotation PBI_ResultType = Table
