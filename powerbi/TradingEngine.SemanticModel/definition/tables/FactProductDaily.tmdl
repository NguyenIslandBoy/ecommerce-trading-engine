/// Product velocity and inventory cover at day x variant grain (365 x 24 = 8,760 rows). Dense: a zero-sale day is a zero row, not a missing one.
table FactProductDaily
	lineageTag: c706cc9a-e76f-44bd-8f78-c4a1f66c7e7f

	column date_day
		dataType: dateTime
		formatString: dd/MM/yyyy
		lineageTag: 7ec5cb4f-df48-428c-afc4-701755466697
		summarizeBy: none
		sourceColumn: date_day

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column variant_id
		dataType: int64
		formatString: #,0
		lineageTag: 4dd40712-0807-432c-8f67-a0ce85769a06
		summarizeBy: sum
		sourceColumn: variant_id

		annotation SummarizationSetBy = Automatic

	column product_title
		dataType: string
		lineageTag: aa62fe3b-9bda-44b4-86ec-c4e975459b71
		summarizeBy: none
		sourceColumn: product_title

		annotation SummarizationSetBy = Automatic

	column sku
		dataType: string
		lineageTag: 792f03f2-12eb-4cec-8bcf-110e2f9602dd
		summarizeBy: none
		sourceColumn: sku

		annotation SummarizationSetBy = Automatic

	column product_type
		dataType: string
		lineageTag: 54737d2c-fab5-422b-8414-dbf348a59804
		summarizeBy: none
		sourceColumn: product_type

		annotation SummarizationSetBy = Automatic

	column units
		dataType: double
		formatString: #,0.00
		lineageTag: 3eb58417-87c6-4b77-a199-544bb1cc4ec3
		summarizeBy: sum
		sourceColumn: units

		annotation SummarizationSetBy = Automatic

	column net_revenue
		dataType: decimal
		formatString: \£#,0.00;-\£#,0.00;\£#,0.00
		lineageTag: 7c38e131-0cfe-4200-a369-ecaaf0206214
		summarizeBy: sum
		sourceColumn: net_revenue

		annotation SummarizationSetBy = Automatic

	column contribution_margin
		dataType: decimal
		formatString: \£#,0.00;-\£#,0.00;\£#,0.00
		lineageTag: 73f67e60-b66f-4b53-a5a4-b1be323795ea
		summarizeBy: sum
		sourceColumn: contribution_margin

		annotation SummarizationSetBy = Automatic

	column velocity_7d
		dataType: double
		formatString: #,0.00
		lineageTag: 48312bb6-be11-4199-9806-f29cdbea2eee
		summarizeBy: sum
		sourceColumn: velocity_7d

		annotation SummarizationSetBy = Automatic

	/// Trailing 28-day mean units/day. PARTIAL for the first 27 days of the series — do not read the start of the trend.
	column velocity_28d
		dataType: double
		formatString: #,0.00
		lineageTag: 45184a3e-1ad2-4929-9218-ecad416132ba
		summarizeBy: sum
		sourceColumn: velocity_28d

		annotation SummarizationSetBy = Automatic

	column velocity_ratio
		dataType: double
		formatString: #,0.00
		lineageTag: a7e81824-c8f3-464a-b651-597ac23f65c7
		summarizeBy: sum
		sourceColumn: velocity_ratio

		annotation SummarizationSetBy = Automatic

	column inventory_quantity
		dataType: int64
		formatString: #,0
		lineageTag: f65a2217-a32a-4ff0-bf2c-497e3f1c99a8
		summarizeBy: sum
		sourceColumn: inventory_quantity

		annotation SummarizationSetBy = Automatic

	/// Inventory / velocity_28d. Uses a CURRENT stock snapshot applied historically, so meaningful only at the latest date.
	column days_of_cover
		dataType: double
		formatString: #,0.00
		lineageTag: be78ee97-7ac0-46cc-a5a7-a5c99f99ebed
		summarizeBy: sum
		sourceColumn: days_of_cover

		annotation SummarizationSetBy = Automatic

	partition FactProductDaily = m
		mode: import
		source =
				let
				    Source = Parquet.Document(File.Contents(DataFolder & "\mart_product_daily.parquet"))
				in
				    Source

	annotation PBI_ResultType = Table
