/// Contribution-margin LTV by cohort x channel x horizon (12 x 4 x 3 = 144 rows). Censoring-aware.
table CohortLTV
	lineageTag: 04b9b41d-d664-408f-95c4-8b34da272c1e

	column cohort_month
		dataType: dateTime
		formatString: dd/MM/yyyy
		lineageTag: b8932534-e3d2-447d-9e38-ba97543a23a0
		summarizeBy: none
		sourceColumn: cohort_month

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column acquisition_channel
		dataType: string
		lineageTag: f46d2d05-d4aa-4fbb-b180-3f11f9c855b4
		summarizeBy: none
		sourceColumn: acquisition_channel

		annotation SummarizationSetBy = Automatic

	column horizon_days
		dataType: int64
		formatString: #,0
		lineageTag: 0d2d408d-87ab-4f7b-8864-e637a20187aa
		summarizeBy: sum
		sourceColumn: horizon_days

		annotation SummarizationSetBy = Automatic

	column cohort_size
		dataType: int64
		formatString: #,0
		lineageTag: c46a9c34-150f-4412-9c20-0f57078f828d
		summarizeBy: sum
		sourceColumn: cohort_size

		annotation SummarizationSetBy = Automatic

	/// FALSE where last acquisition + horizon extends past the last date with data.
	column has_full_exposure
		dataType: boolean
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 753a8057-85a6-42ea-929e-564387755364
		summarizeBy: none
		sourceColumn: has_full_exposure

		annotation SummarizationSetBy = Automatic

	column cum_net_revenue
		dataType: decimal
		formatString: \£#,0.00;-\£#,0.00;\£#,0.00
		lineageTag: 943195b5-d5cb-4c34-8b51-e0cb2b91709b
		summarizeBy: sum
		sourceColumn: cum_net_revenue

		annotation SummarizationSetBy = Automatic

	column cum_contribution_margin
		dataType: decimal
		formatString: \£#,0.00;-\£#,0.00;\£#,0.00
		lineageTag: 136d1c88-ce07-4455-b3d5-d3e960dc2c5b
		summarizeBy: sum
		sourceColumn: cum_contribution_margin

		annotation SummarizationSetBy = Automatic

	/// Ex-VAT revenue per acquired customer. Kept for contrast; ltv_margin is the decision metric.
	column ltv_revenue
		dataType: double
		formatString: #,0.00
		lineageTag: f61ed987-efbf-4ea4-9ea6-adbc3706c959
		summarizeBy: sum
		sourceColumn: ltv_revenue

		annotation SummarizationSetBy = Automatic

	/// NULL under censoring. THE figure the CAC/LTV comparison uses. Margin-based: a revenue LTV overstates headroom above CAC by ~1.4x.
	column ltv_margin
		dataType: double
		formatString: #,0.00
		lineageTag: e012ba67-7ebb-4d01-98c6-4b99ff23dbbf
		summarizeBy: sum
		sourceColumn: ltv_margin

		annotation SummarizationSetBy = Automatic

	partition CohortLTV = m
		mode: import
		source =
				let
				    Source = Parquet.Document(File.Contents(DataFolder & "\mart_ltv.parquet"))
				in
				    Source

	annotation PBI_ResultType = Table
