model Model
	culture: en-GB
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-GB
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["DataFolder","DimDate","DimChannel","DimProduct","DimCampaign","FactDailyTrading","FactAdSpendDaily","FactProductDaily","FactEmailFlowWeekly","FactDataQuality","CohortRetention","CohortLTV","Measures"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode","MCP-PBIModeling"]

ref table DimDate
ref table DimChannel
ref table DimProduct
ref table DimCampaign
ref table FactDailyTrading
ref table FactAdSpendDaily
ref table FactProductDaily
ref table FactEmailFlowWeekly
ref table FactDataQuality
ref table CohortRetention
ref table CohortLTV
ref table Measures
ref cultureInfo en-GB
