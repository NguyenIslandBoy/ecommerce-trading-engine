/// PRIMARY FACT. Daily trading by last-click channel (365 days x 4 channels = 1,460 rows). The metric spine.
table FactDailyTrading
	lineageTag: 4040bdd1-c51b-4a56-86d6-03cf9fdf3813

	column date_day
		dataType: dateTime
		formatString: dd/MM/yyyy
		lineageTag: 186fdca6-768a-4e88-81fd-d6328637f9e5
		summarizeBy: none
		sourceColumn: date_day

	column channel
		dataType: string
		lineageTag: f8a87fcb-b7a7-4fd2-821a-8a5ef16f484c
		summarizeBy: none
		sourceColumn: channel

	column orders
		dataType: int64
		formatString: #,0
		lineageTag: d2f237e6-0f10-433f-95ee-ba5dbae6e739
		summarizeBy: sum
		sourceColumn: orders

	column new_customers
		dataType: int64
		formatString: #,0
		lineageTag: 0f14f244-5a7c-4497-b01e-2a2a83bbb701
		summarizeBy: sum
		sourceColumn: new_customers

	column returning_customers
		dataType: int64
		formatString: #,0
		lineageTag: dab235e7-85f3-4560-a8a8-2e73bb10886d
		summarizeBy: sum
		sourceColumn: returning_customers

	/// EX-VAT. Will not match a VAT-inclusive figure quoted elsewhere.
	column net_revenue
		dataType: decimal
		formatString: \£#,0.00
		lineageTag: 1dfc6a43-6842-4f02-89a7-dbc4fec1f778
		summarizeBy: sum
		sourceColumn: net_revenue

	column contribution_margin
		dataType: decimal
		formatString: \£#,0.00
		lineageTag: cfaa2111-1a45-4fa4-9a27-3bb6d6b89bd4
		summarizeBy: sum
		sourceColumn: contribution_margin

	/// Ex-VAT and excludes shipping.
	column aov
		dataType: decimal
		formatString: \£#,0.00
		lineageTag: dd9f9758-a9b8-41ec-964d-b7e011a6386a
		summarizeBy: none
		sourceColumn: aov

	column ad_spend
		dataType: decimal
		formatString: \£#,0.00
		lineageTag: b45de6c9-590e-45e8-b0ad-3539e8911049
		summarizeBy: sum
		sourceColumn: ad_spend

	column clicks
		dataType: double
		formatString: #,0
		lineageTag: fce14d13-0d98-4a3c-a02d-4c40cae82e74
		summarizeBy: sum
		sourceColumn: clicks

	column impressions
		dataType: double
		formatString: #,0
		lineageTag: 9fc0dfda-eb1a-4da4-826e-f87559096a74
		summarizeBy: sum
		sourceColumn: impressions

	/// TIER C - depends on last-click attribution. NULL for tiktok and unattributed by construction.
	column channel_cac
		dataType: decimal
		formatString: \£#,0.00
		lineageTag: 03ce1184-376d-42b0-b218-9b0ab2e748c4
		summarizeBy: none
		sourceColumn: channel_cac

	/// Ex-VAT, so ~17% lower than a platform-reported ROAS.
	column channel_roas
		dataType: decimal
		formatString: #,0.00
		lineageTag: c9d9ae3e-d66a-4ed7-95a2-2dc9d0d1c8fd
		summarizeBy: none
		sourceColumn: channel_roas

	column channel_margin_roas
		dataType: decimal
		formatString: #,0.00
		lineageTag: 888f9ad4-81c6-4919-8014-b6e3a73dda83
		summarizeBy: none
		sourceColumn: channel_margin_roas

	/// FALSE when any ad source has an ingestion gap that day. Load-bearing: without it, blended CAC on the two missing Meta days reads a fabricated 42% improvement.
	column ad_spend_is_complete
		dataType: boolean
		lineageTag: 606d8195-ca62-4bd2-bf7d-27babff1c9c3
		summarizeBy: none
		sourceColumn: ad_spend_is_complete

	/// TIER B - attribution-free. NULL when ad_spend_is_complete is false.
	column blended_cac
		dataType: decimal
		formatString: \£#,0.00
		lineageTag: 155611ac-3b67-4680-b3ee-ab78d335cb1c
		summarizeBy: none
		sourceColumn: blended_cac

	column is_peak_season
		dataType: boolean
		lineageTag: 090c3629-7524-4451-b120-1eee58cc647d
		summarizeBy: none
		sourceColumn: is_peak_season

	column iso_dow
		dataType: int64
		formatString: 0
		lineageTag: 86be1892-3d88-48cf-abe9-7f409762c870
		summarizeBy: none
		sourceColumn: iso_dow

	column week_start
		dataType: dateTime
		formatString: dd/MM/yyyy
		lineageTag: 5d26136e-6b4c-4c6d-b322-f9f7a8a4972c
		summarizeBy: none
		sourceColumn: week_start

	partition FactDailyTrading = m
		mode: import
		source =
				let
				    Source = Parquet.Document(File.Contents(DataFolder & "\mart_daily_trading.parquet"))
				in
				    Source

