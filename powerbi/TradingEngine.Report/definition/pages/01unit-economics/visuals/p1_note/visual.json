  "visual": {
    "visualType": "textbox",
    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "What this means\n\n",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "13pt",
                      "color": "#0B1A2E",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "Both sides moved at once.  ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#1A2332",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "Acquisition got 29% more expensive while each customer became 29% less valuable. Neither alone would be alarming; together the ratio fell 45% — 4.42x to 2.43x.\n\n",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#1A2332"
                    }
                  },
                  {
                    "value": "Meta is now below break-even.  ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#1A2332",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "Meta-acquired customers cost £34.83 on trailing CAC and return £31.01 of 60-day margin — 0.89x, a loss before overheads. Channel figures are last-click, so this sizes a test rather than settling a verdict.\n\n",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#1A2332"
                    }
                  },
                  {
                    "value": "The cause is on page 2.  ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#1A2332",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "LTV fell because customers stopped coming back — not because they spent less on the first order.\n\n",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#1A2332"
                    }
                  },
                  {
                    "value": "Note: the last two cohorts are censored and return blank by design.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt",
                      "color": "#6B7785",
                      "fontStyle": "italic"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              }
            ]
          }
        }
      ]
    },
