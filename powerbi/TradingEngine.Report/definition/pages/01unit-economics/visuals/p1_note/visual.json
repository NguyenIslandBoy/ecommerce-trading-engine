  "visual": {
    "visualType": "textbox",
    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "What this means\n\n",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "13pt",
                      "color": "#0B1A2E",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "Both sides moved at once.  ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#1A2332",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "Acquisition got 53% more expensive while each customer became 29% less valuable. Neither alone would be alarming; together the ratio more than halved.\n\n",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#1A2332"
                    }
                  },
                  {
                    "value": "Payback is now marginal.  ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#1A2332",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "At 2.09x on a 60-day horizon, Meta-acquired customers (CAC £34.74) sit close to break-even before overheads.\n\n",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#1A2332"
                    }
                  },
                  {
                    "value": "The cause is on page 3.  ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#1A2332",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "LTV fell because customers stopped coming back — not because they spent less on the first order.\n\n",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#1A2332"
                    }
                  },
                  {
                    "value": "Note: the last two cohorts are censored and return blank by design.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt",
                      "color": "#6B7785",
                      "fontStyle": "italic"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              }
            ]
          }
        }
      ]
    },
