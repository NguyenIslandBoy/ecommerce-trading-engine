          "properties": {
            "paragraphs": [
              {
                "horizontalTextAlignment": "left",
                "textRuns": [
                  {
                    "value": "Why this is wired into the metric, not just reported\n\n",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "13pt",
                      "color": "#0B1A2E",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "A naive daily detector would say:  ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#C0392B",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "\"Meta spend dropped to £0 on 15–16 March — campaigns paused, investigate immediately.\"\n\n",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#1A2332"
                    }
                  },
                  {
                    "value": "What actually happened:  ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#2E8B57",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "the rows were never ingested. Spend did not change.\n\n",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#1A2332"
                    }
                  },
                  {
                    "value": "The consequence if left unhandled:  ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#1A2332",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "blended CAC on those days computes from Google spend alone and reads £6.75 and £6.33 against a true level of ~£11.50 — a fabricated 42% improvement in acquisition cost. [Blended CAC] excludes incomplete days from both numerator and denominator instead.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#1A2332"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
    },
