          "properties": {
            "paragraphs": [
              {
                "horizontalTextAlignment": "left",
                "textRuns": [
                  {
                    "value": "Artifact, not lost demand\n\n",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "13pt",
                      "color": "#0B1A2E",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "Looks like:  ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#C0392B",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "\"Engagement is collapsing across all six flows — fix the flows.\"\n\n",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#1A2332"
                    }
                  },
                  {
                    "value": "Actually:  ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#2E8B57",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "opens and clicks fell; orders per recipient did not. The flows monetise exactly as before — a deliverability or open-tracking change.\n\n",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#1A2332"
                    }
                  },
                  {
                    "value": "The rule:  ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#1A2332",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "engagement down + conversion flat → measurement. Engagement down + conversion down → commercial. The same test applied to Meta on page 2 returns the opposite verdict.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#1A2332"
                    }
                  }
                ]
              }
            ]
          }
