    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "horizontalTextAlignment": "left",
                "textRuns": [
                  {
                    "value": "Why both are correct\n\n",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "13pt",
                      "color": "#0B1A2E",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "Looks like:  ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#C0392B",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "repeat rate steady at 24%. Retention is fine, nothing to do.\n\n",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#1A2332"
                    }
                  },
                  {
                    "value": "Actually:  ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#2E8B57",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "that 24% is carried almost entirely by the Jul–Nov 2024 cohorts still buying. Essentially no customer acquired in 2025 returns. The blended number measures the whole book; the cohort number measures each intake.\n\n",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#1A2332"
                    }
                  },
                  {
                    "value": "It is a lagging indicator dressed as a current one — it keeps looking healthy until the 2024 cohorts stop buying.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#1A2332"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
    },
