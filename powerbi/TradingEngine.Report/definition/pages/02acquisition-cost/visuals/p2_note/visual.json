        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Two causes, two different responses\n\n",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "13pt",
                      "color": "#0B1A2E",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "Naive reading:  ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#C0392B",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "\"Meta CAC is up 75% — cut the Meta budget.\"\n\n",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#1A2332"
                    }
                  },
                  {
                    "value": "What the decomposition shows:  ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#2E8B57",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "CPM +56% is auction price. You cannot control it — only decide whether to keep paying it. CTR −36% is creative relevance. You can control that, cheaply and reversibly.\n\n",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#1A2332"
                    }
                  },
                  {
                    "value": "Frequency is flat at ~1.22 all year, ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#1A2332",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "which is what rules out audience saturation. Refresh creative first; reallocate only the auction-attributable share.\n\n",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#1A2332"
                    }
                  },
                  {
                    "value": "CPC, CPM and CTR are platform-reported and need no attribution.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt",
                      "color": "#6B7785",
                      "fontStyle": "italic"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              }
            ]
          }
        }
      ]
    },
