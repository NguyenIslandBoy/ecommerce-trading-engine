# Copy to .env (gitignored) and fill in. Read by scripts/publish_to_bigquery.py;
# variables already set in the environment win over this file.
# Never commit the real .env or the key file it points to.

# Google Cloud project that will hold the dataset.
BQ_PROJECT_ID=
# Path to a service-account JSON key with BigQuery Data Editor + Job User.
# Keep the key file outside the repo.
GOOGLE_APPLICATION_CREDENTIALS=
# Dataset location. Defaults to US.
BQ_LOCATION=US
